# Salin file ini menjadi .env dan sesuaikan nilainya

# --- Database (PostgreSQL) ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://safehike:safehike123@localhost:5432/safehike

# --- Keamanan JWT ---
SECRET_KEY=supersecretkey-safehike-2024-changeme-in-production

# --- Google Gemini AI ---
# Dapatkan API Key di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
